# ── SerpAPI ──────────────────────────────────────────────────────────────────
# Get your key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# Base URL for SerpAPI (change only if using a proxy)
SERPAPI_BASE_URL=https://serpapi.com/search

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL of your local (or remote) Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Model to use — must be pulled first: ollama pull <model>
# Examples: llama3.2  |  mistral  |  gemma3  |  qwen2.5  |  gpt-oss:20b
OLLAMA_MODEL=llama3.2
